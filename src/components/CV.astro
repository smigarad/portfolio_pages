---
interface Experience {
  company: string;
  role: string;
  period: string;
  description: string;
}

interface Props {
  experiences: Experience[];
}

const { experiences } = Astro.props;
---

<section id="cv" class="py-16">
  <div class="mx-auto max-w-4xl px-4">
    <h2 class="mb-8 text-3xl font-bold text-gray-900 dark:text-white">CV</h2>

    <div class="space-y-8">
      {
        experiences.map((exp) => (
          <div class="border-l-2 border-gray-200 pl-6 dark:border-gray-700">
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
              {exp.role}
            </h3>
            <p class="mt-1 text-gray-600 dark:text-gray-400">
              {exp.company} · {exp.period}
            </p>
            <p class="mt-3 text-gray-600 dark:text-gray-300">{exp.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
