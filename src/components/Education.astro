---
interface Education {
  institution: string;
  degree: string;
  field: string;
  period: string;
}

interface Props {
  education: Education[];
}

const { education } = Astro.props;
---

<section id="education" class="py-16">
  <div class="mx-auto max-w-4xl px-4">
    <h2 class="mb-8 text-3xl font-bold text-gray-900 dark:text-white">Vzdělání</h2>
    <div class="space-y-6">
      {education.map((edu) => (
        <div class="border-l-2 border-gray-200 pl-6 dark:border-gray-700">
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white">{edu.institution}</h3>
          <p class="mt-1 text-gray-600 dark:text-gray-400">{edu.degree}, {edu.field} · {edu.period}</p>
        </div>
      ))}
    </div>
  </div>
</section>
