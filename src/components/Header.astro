---
const navLinks = [
  { href: "#about", label: "O mně" },
  { href: "#cv", label: "CV" },
  { href: "#education", label: "Vzdělání" },
  { href: "#certifications", label: "Certifikace" },
  { href: "#contact", label: "Kontakt" },
];
---

<header class="sticky top-0 z-50 border-b border-gray-200 bg-white/80 backdrop-blur-sm dark:border-gray-700 dark:bg-gray-900/80">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4">
    <a href="/" class="text-xl font-bold text-gray-900 dark:text-white" aria-label="Domů">
      Radek Šmiga
    </a>

    <ul class="flex gap-6">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-gray-600 transition-colors hover:text-gray-900 dark:text-gray-300 dark:hover:text-white"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
