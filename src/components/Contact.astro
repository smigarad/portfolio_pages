---
interface Props {
  email: string;
}

const { email } = Astro.props;
---

<section id="contact" class="bg-gray-50 py-16 dark:bg-gray-800">
  <div class="mx-auto max-w-4xl px-4">
    <h2 class="mb-8 text-3xl font-bold text-gray-900 dark:text-white">Kontakt</h2>

    <div class="rounded-lg border border-gray-200 bg-white p-8 dark:border-gray-700 dark:bg-gray-900">
      <p class="mb-6 text-gray-600 dark:text-gray-300">
        Máte zájem o spolupráci? Neváhejte mě kontaktovat.
      </p>

      <form
        name="contact"
        method="POST"
        data-netlify="true"
        class="mb-8 space-y-6"
      >
        <input type="hidden" name="form-name" value="contact" />

        <div>
          <label
            for="name"
            class="mb-2 block text-sm font-medium text-gray-900 dark:text-white"
          >
            Jméno
          </label>
          <input
            type="text"
            id="name"
            name="name"
            required
            class="w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-gray-900 transition-colors focus:border-gray-500 focus:outline-none focus:ring-2 focus:ring-gray-200 dark:border-gray-600 dark:bg-gray-800 dark:text-white dark:focus:border-gray-400 dark:focus:ring-gray-700"
            placeholder="Vaše jméno"
          />
        </div>

        <div>
          <label
            for="email"
            class="mb-2 block text-sm font-medium text-gray-900 dark:text-white"
          >
            Email
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-gray-900 transition-colors focus:border-gray-500 focus:outline-none focus:ring-2 focus:ring-gray-200 dark:border-gray-600 dark:bg-gray-800 dark:text-white dark:focus:border-gray-400 dark:focus:ring-gray-700"
            placeholder="vas@email.cz"
          />
        </div>

        <div>
          <label
            for="message"
            class="mb-2 block text-sm font-medium text-gray-900 dark:text-white"
          >
            Zpráva
          </label>
          <textarea
            id="message"
            name="message"
            required
            rows="5"
            class="w-full resize-none rounded-lg border border-gray-300 bg-white px-4 py-3 text-gray-900 transition-colors focus:border-gray-500 focus:outline-none focus:ring-2 focus:ring-gray-200 dark:border-gray-600 dark:bg-gray-800 dark:text-white dark:focus:border-gray-400 dark:focus:ring-gray-700"
            placeholder="Vaše zpráva..."
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full rounded-lg bg-gray-900 px-6 py-3 font-medium text-white transition-colors hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2 dark:bg-white dark:text-gray-900 dark:hover:bg-gray-200 dark:focus:ring-gray-300 sm:w-auto"
        >
          Odeslat zprávu
        </button>
      </form>

      <div class="border-t border-gray-200 pt-6 dark:border-gray-700">
        <p class="mb-3 text-sm text-gray-500 dark:text-gray-400">
          Nebo mě kontaktujte přímo:
        </p>
        <a
          href={`mailto:${email}`}
          class="inline-flex items-center gap-2 text-lg font-medium text-gray-900 transition-colors hover:text-gray-600 dark:text-white dark:hover:text-gray-300"
        >
          <svg
            class="h-5 w-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
            />
          </svg>
          {email}
        </a>
      </div>
    </div>
  </div>
</section>
