---
interface Props {
  name: string;
  tagline: string;
}

const { name, tagline } = Astro.props;
---

<section class="relative flex min-h-[80vh] items-center justify-center px-4">
  <!-- Background image -->
  <div
    class="absolute inset-0 bg-cover bg-center bg-no-repeat"
    style="background-image: url('https://picsum.photos/1920/1080?grayscale');"
  >
  </div>
  <!-- Overlay for readability -->
  <div class="absolute inset-0 bg-white/80 dark:bg-gray-900/80"></div>

  <!-- Content -->
  <div class="relative z-10 text-center">
    <img
      src="/public/images/profile_picture.jpg"
      alt={`Fotka ${name}`}
      class="mx-auto mb-6 h-32 w-32 rounded-full border-4 border-gray-200 object-cover shadow-lg sm:h-40 sm:w-40 dark:border-gray-700"
    />
    <h1 class="mb-4 text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl md:text-6xl dark:text-white">
      {name}
    </h1>
    <p class="mx-auto max-w-2xl text-lg text-gray-600 sm:text-xl dark:text-gray-300">
      {tagline}
    </p>

    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a
        href="#contact"
        class="rounded-lg bg-gray-900 px-6 py-3 font-medium text-white transition-colors hover:bg-gray-800 dark:bg-white dark:text-gray-900 dark:hover:bg-gray-100"
      >
        Kontaktujte mě
      </a>
      <a
        href="#cv"
        class="rounded-lg border border-gray-300 bg-white px-6 py-3 font-medium text-gray-900 transition-colors hover:bg-gray-50 dark:border-gray-600 dark:bg-gray-800 dark:text-white dark:hover:bg-gray-700"
      >
        Zobrazit CV
      </a>
    </div>
  </div>
</section>
