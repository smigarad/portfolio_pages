---
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<section id="about" class="bg-gray-50 py-16 dark:bg-gray-800">
  <div class="mx-auto max-w-4xl px-4">
    <h2 class="mb-8 text-3xl font-bold text-gray-900 dark:text-white" data-i18n="about.title">O mně</h2>
    <div class="prose prose-lg max-w-none text-gray-600 dark:prose-invert dark:text-gray-300">
      <p>{text}</p>
    </div>
  </div>
</section>
