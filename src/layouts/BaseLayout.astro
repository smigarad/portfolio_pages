---
import "@/styles/global.css";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import LanguageSwitcher from "@components/LanguageSwitcher.astro";
import { SEO } from "astro-seo";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Personal portfolio of Radek Šmiga" } =
  Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Theme and language detection - prevent FOUC -->
    <script is:inline>
      (function() {
        // Theme detection
        const theme = localStorage.getItem('theme');
        if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }

        // Language detection
        const storedLang = localStorage.getItem('lang');
        if (storedLang === 'cs' || storedLang === 'en') {
          document.documentElement.lang = storedLang;
        } else {
          const browserLang = navigator.language.toLowerCase();
          document.documentElement.lang = browserLang.startsWith('cs') ? 'cs' : 'en';
        }
      })();
    </script>

    <SEO
      title={title}
      description={description}
      canonical={canonicalURL.href}
      openGraph={{
        basic: {
          title: title,
          type: "website",
          image: "/og-image.png",
        },
        optional: {
          description: description,
          siteName: "Radek Šmiga",
        },
      }}
    />
  </head>
  <body
    class="min-h-screen bg-white text-gray-900 antialiased dark:bg-gray-900 dark:text-gray-100"
  >
    <Header />
    <LanguageSwitcher />

    <main>
      <slot />
    </main>

    <Footer />

    <!-- i18n client-side handler -->
    <script>
      import "../scripts/i18n-client";
    </script>
  </body>
</html>
