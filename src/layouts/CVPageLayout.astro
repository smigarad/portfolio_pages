---
import "@/styles/global.css";
import { SEO } from "astro-seo";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "CV - Radek Šmiga" } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Theme and language detection - prevent FOUC -->
    <script is:inline>
      (function() {
        // Theme detection
        const theme = localStorage.getItem('theme');
        if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }

        // Language detection
        const storedLang = localStorage.getItem('lang');
        if (storedLang === 'cs' || storedLang === 'en') {
          document.documentElement.lang = storedLang;
        } else {
          const browserLang = navigator.language.toLowerCase();
          document.documentElement.lang = browserLang.startsWith('cs') ? 'cs' : 'en';
        }
      })();
    </script>

    <SEO
      title={title}
      description={description}
      canonical={canonicalURL.href}
      openGraph={{
        basic: {
          title: title,
          type: "website",
          image: "/og-image.svg",
        },
        optional: {
          description: description,
          siteName: "Radek Šmiga",
        },
      }}
    />

    <style>
      @media print {
        .cv-toolbar {
          display: none !important;
        }
      }
    </style>
  </head>
  <body class="cv-page min-h-screen bg-white text-gray-900 antialiased dark:bg-gray-900 dark:text-gray-100">
    <!-- Print toolbar - visible only on screen -->
    <div class="cv-toolbar no-print sticky top-0 z-50 border-b border-gray-200 bg-white/95 backdrop-blur dark:border-gray-700 dark:bg-gray-900/95">
      <div class="mx-auto flex max-w-4xl items-center justify-between px-4 py-3">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-sm font-medium text-gray-600 transition-colors hover:text-gray-900 dark:text-gray-400 dark:hover:text-white"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span data-i18n="cvPage.backToPortfolio">Zpět na portfolio</span>
        </a>

        <div class="flex items-center gap-4">
          <!-- Language switcher -->
          <div class="flex items-center gap-1 rounded-full bg-gray-100 px-2 py-1 dark:bg-gray-800">
            <button
              id="cv-lang-cs"
              type="button"
              class="rounded-full px-2 py-0.5 text-sm font-medium transition-colors"
              aria-label="Přepnout na češtinu"
            >
              CZ
            </button>
            <span class="text-gray-400 dark:text-gray-500">|</span>
            <button
              id="cv-lang-en"
              type="button"
              class="rounded-full px-2 py-0.5 text-sm font-medium transition-colors"
              aria-label="Switch to English"
            >
              EN
            </button>
          </div>

          <!-- Print button -->
          <button
            onclick="window.print()"
            class="inline-flex items-center gap-2 rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-gray-800 dark:bg-white dark:text-gray-900 dark:hover:bg-gray-100"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
            </svg>
            <span data-i18n="cvPage.print">Tisk / Uložit PDF</span>
          </button>
        </div>
      </div>
    </div>

    <main class="mx-auto max-w-4xl px-4 py-8 print:py-0">
      <slot />
    </main>

    <!-- i18n client-side handler -->
    <script>
      import "../scripts/i18n-client";

      // CV page language switcher
      function setupCVLanguageSwitcher() {
        const btnCs = document.getElementById('cv-lang-cs');
        const btnEn = document.getElementById('cv-lang-en');

        if (!btnCs || !btnEn) return;

        const activeClasses = ['bg-gray-900', 'text-white', 'dark:bg-white', 'dark:text-gray-900'];
        const inactiveClasses = ['text-gray-600', 'hover:text-gray-900', 'dark:text-gray-400', 'dark:hover:text-white'];

        function updateButtons(lang: string) {
          if (lang === 'cs') {
            btnCs.classList.remove(...inactiveClasses);
            btnCs.classList.add(...activeClasses);
            btnEn.classList.remove(...activeClasses);
            btnEn.classList.add(...inactiveClasses);
          } else {
            btnEn.classList.remove(...inactiveClasses);
            btnEn.classList.add(...activeClasses);
            btnCs.classList.remove(...activeClasses);
            btnCs.classList.add(...inactiveClasses);
          }
        }

        function setLang(lang: 'cs' | 'en') {
          localStorage.setItem('lang', lang);
          document.documentElement.lang = lang;
          updateButtons(lang);
          window.dispatchEvent(new CustomEvent('langchange', { detail: { lang } }));
        }

        // Initialize
        const currentLang = document.documentElement.lang || 'cs';
        updateButtons(currentLang);

        btnCs.addEventListener('click', () => setLang('cs'));
        btnEn.addEventListener('click', () => setLang('en'));

        // Listen for external language changes
        window.addEventListener('langchange', (e) => {
          const customEvent = e as CustomEvent<{ lang: string }>;
          updateButtons(customEvent.detail.lang);
        });
      }

      // Run on load
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupCVLanguageSwitcher);
      } else {
        setupCVLanguageSwitcher();
      }
    </script>
  </body>
</html>
